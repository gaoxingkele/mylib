  "competencies": [
    {
      "id": "GRID-01",
      "name": "需求场景与电网问题锚定",
      "type": "inference",
      "owner_roles": [
        3
      ],
      "source_ids": [
        "R01",
        "R02",
        "R03",
        "R04"
      ],
      "review_questions": [
        "所述痛点是否对应明确电网场景、对象、时空尺度和运行约束？",
        "项目是否解释现有方法为何不足，而不是只罗列技术名词？",
        "预期成果是否能回到调度、规划、运维、市场或设备应用场景中验证？"
      ],
      "failure_pattern": "只列热点工具，未定义业务对象和现有方法的缺口。",
      "evidence_to_request": [
        "实际业务问题与数据来源",
        "现有系统或流程对照"
      ],
      "transfer_limit": "参考资料只支持审查方法；具体资格、数值、周期、规模、费率与附件以本轮指南、模板及业主要求为准。"
    },
    {
      "id": "GRID-02",
      "name": "机理建模与量化评价",
      "type": "inference",
      "owner_roles": [
        4
      ],
      "source_ids": [
        "R02",
        "R03",
        "R05"
      ],
      "review_questions": [
        "核心机理、状态变量和扰动因素是否被定义到可建模程度？",
        "量化指标是否能由数据、仿真或试验支撑，而不是停留在定性描述？",
        "模型输出是否能解释关键特征或辅助决策，而非只给黑箱结果？"
      ],
      "failure_pattern": "机理、变量或假设不明，创新无法对应可检验结果。",
      "evidence_to_request": [
        "变量/假设及约束说明",
        "理论或实验证据与创新映射"
      ],
      "transfer_limit": "参考资料只支持审查方法；具体资格、数值、周期、规模、费率与附件以本轮指南、模板及业主要求为准。"
    },
    {
      "id": "GRID-03",
      "name": "物理约束与安全边界",
      "type": "inference",
      "owner_roles": [
        4,
        6
      ],
      "source_ids": [
        "R13",
        "R14",
        "R15"
      ],
      "review_questions": [
        "方案是否列出电气、热、机械、环境、寿命或安全约束？",
        "异常工况、故障穿越、地震/强风/高影响天气等边界是否纳入验证？",
        "控制策略是否可能突破设备、材料或系统安全边界？"
      ],
      "failure_pattern": "算法输出没有约束校核，正常工况被外推到故障或极端条件。",
      "evidence_to_request": [
        "适用调度/保护或业务规则",
        "正常/故障/极端工况校核方案"
      ],
      "transfer_limit": "参考资料只支持审查方法；具体资格、数值、周期、规模、费率与附件以本轮指南、模板及业主要求为准。"
    },
    {
      "id": "GRID-04",
      "name": "试验仿真与示范设计",
      "type": "inference",
      "owner_roles": [
        4
      ],
      "source_ids": [
        "R03",
        "R10",
        "R11"
      ],
