{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepLLM paper.json (CPA paper-space, adapted)",
  "type": "object",
  "required": ["source_pdf", "sections", "figures", "tables", "algorithms", "equations", "signals"],
  "properties": {
    "source_pdf": {"type": "string"},
    "n_pages": {"type": "integer"},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "level", "text"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "level": {"type": "integer"},
          "text": {"type": "string"},
          "refs": {"type": "object"}
        }
      }
    },
    "figures": {"type": "array"},
    "tables": {"type": "array"},
    "algorithms": {"type": "array"},
    "equations": {"type": "array"},
    "signals": {"type": "object"}
  }
}
